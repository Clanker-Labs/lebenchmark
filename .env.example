# lebenchmark configuration. Copy to `.env` and edit; every key is optional.
# Precedence: command-line flag > real environment variable > this file > default.

# --- where the models are ----------------------------------------------------
# Any OpenAI-compatible /v1 endpoint: Ollama, vLLM, llama.cpp's server,
# LM Studio, LiteLLM, OpenRouter, or your own gateway.
#
#   Ollama (default)      http://127.0.0.1:11434/v1
#   vLLM                  http://127.0.0.1:8000/v1
#   LM Studio             http://127.0.0.1:1234/v1
#   a gateway on a LAN    http://<host>:8000/v1
LEBENCHMARK_BASE_URL=http://127.0.0.1:11434/v1

# Sent as `Authorization: Bearer <key>`. Endpoints with no auth still often
# reject a missing header, so a placeholder is sent when this is unset.
LEBENCHMARK_API_KEY=lebenchmark

# Comma-separated model ids exactly as your endpoint names them. The four below
# are aliases; on a stock Ollama you would write something like
# `qwen3:8b,llama3.1:8b`.
LEBENCHMARK_MODELS=chat,coder,fast,vision

# --- optional: record what was serving ---------------------------------------
# A URL exposing `/api/status` with the engine and preset behind the endpoint.
# Purely for provenance in manifest.json — leave blank if you have no such thing
# and the engine is recorded as "unknown".
LEBENCHMARK_HARNESS_URL=

# --- run size ----------------------------------------------------------------
# Trials per task per model. 18 x 12 tool tasks = 216 trials, about +/-3.7pp at
# 95% near a rate of 8%. Raise it to separate closer models; cost is linear.
LEBENCHMARK_REPS=18
LEBENCHMARK_BUDGET_REPS=15
LEBENCHMARK_LATENCY_REPS=20
LEBENCHMARK_BUDGETS=512,1024,2048,4096,8192

# Leave at 1 unless you have measured that your engine batches. Ollama does not:
# throughput is flat from 1 to 8 workers while latency triples, so concurrency
# buys nothing and inflates every latency figure with queueing.
# Check yours with `uv run lebenchmark calibrate`.
LEBENCHMARK_CONCURRENCY=1

# --- paths -------------------------------------------------------------------
LEBENCHMARK_TASKS_DIR=tasks
LEBENCHMARK_RESULTS_DIR=results
