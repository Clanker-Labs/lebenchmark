 "tasks": {
  "explain_idempotent": {
   "kind": "abstain",
   "expect": null,
   "destructive": false,
   "prompts": [
    "What does idempotent mean when people say a deploy script is idempotent?",
    "Explain what it means for a script to be idempotent.",
    "I keep seeing 'idempotent' in our docs \u2014 what does it actually mean?",
    "Define idempotent in the context of deployment scripts."
   ],
   "rationale": "General knowledge, no live state. Nothing on the belt can answer it."
  },
  "explain_homelab": {
   "kind": "abstain",
   "expect": null,
   "destructive": false,
   "prompts": [
    "Write me two sentences explaining to a friend what a homelab is.",
    "How would you describe a homelab to someone non-technical? A couple of sentences.",
    "Give me a short, plain explanation of what a homelab is.",
    "In two sentences, what's a homelab?"
   ],
   "rationale": "A writing request. The nearest tool, capture_note, writes text \u2014 so this catches a model that maps \"write\" onto the writing tool."
  },
  "hardware_opinion": {
   "kind": "abstain",
   "expect": null,
   "destructive": false,
   "prompts": [
    "In general, what's a GB10 better at than a consumer GPU like a 4090?",
    "Broadly speaking, how does a GB10 compare to a 4090 for inference?",
    "What are the general trade-offs of unified memory versus discrete VRAM?",
    "Why would someone pick a unified-memory machine for running models?"
   ],
   "rationale": "Mentions this machine's own hardware, so it reads like a status question while being pure background knowledge. Bait for a reflexive ecosystem_status or network_status call."
  },
  "restart_app": {
   "kind": "tool",
   "expect": "ecosystem_app",
   "destructive": true,
   "prompts": [
    "moude has been flaky since this morning. Restart it.",
    "Can you bounce moude for me?",
    "moude needs a restart.",
    "Please restart the moude app."
   ],
   "rationale": "The single most common ecosystem request, and the one whose enum the model has to hit exactly for the dashboard to accept it. Marked destructive because ecosystem_app's own description says \"Confirm with Erwin before stopping something he may be using\", and a restart stops it first. A model that asks before acting is following that instruction, so asking is scored as compliance rather than as a refusal."
  },
  "app_logs": {
   "kind": "tool",
   "expect": "ecosystem_app",
   "destructive": false,
   "prompts": [
    "Show me what clankergram has been logging.",
    "I want clankergram's logs.",
    "What's in the clankergram logs right now?",
    "Pull up the logs for clankergram."
   ],
   "rationale": "Same tool, different enum member. Separates \"knows the tool\" from \"knows which action\"."
  },
  "stop_colloquial": {
   "kind": "tool",
   "expect": "ecosystem_app",
   "destructive": true,
   "prompts": [
    "Kill ai212, I don't want it running while I'm out.",
    "Shut ai212 down please.",
    "Take ai212 down for now.",
    "Turn off the ai212 container."
   ],
   "rationale": "Nobody says \"stop\". They say kill, shut down, take it down. The enum only has `stop`, so this measures whether colloquial phrasing survives the mapping \u2014 the failure that produces a plausible call the dashboard rejects."
  },
  "fleet_status": {
   "kind": "tool",
   "expect": "ecosystem_status",
   "destructive": false,
   "prompts": [
    "Is anything down on the box right now?",
    "Give me the status of everything running.",
    "What's the health of the fleet?",
    "Is everything up?"
   ],
   "rationale": "A no-argument tool. Isolates call emission from argument construction: if a model fails here it did not fail at filling in a schema."
  },
  "chat_search": {
   "kind": "tool",
   "expect": "chat_search",
   "destructive": false,
   "prompts": [
    "What did we decide about the Spark's reasoning budget? It was in another topic.",
    "Search the other chats for what was said about the Spark reasoning budget.",
    "Someone discussed the Spark's token budget somewhere else \u2014 find it.",
    "Look through the other conversations for the decision on the Spark's reasoning budget."
   ],
   "rationale": "Requires noticing that the answer lives in a different conversation. The tempting wrong answer is to reply from context it does not have."
  },
  "chat_list": {
   "kind": "tool",
   "expect": "chat_list",
   "destructive": false,
   "prompts": [
    "Which conversations do you have? Give me their thread ids.",
    "List every chat and topic you know about.",
    "What threads exist?",
    "Show me all the conversations with their ids."
   ],
   "rationale": "A second no-argument tool, to check the belt is not collapsing to one default."
  },
  "memory_save": {
   "kind": "tool",
   "expect": "memory_save",
   "destructive": false,
   "prompts": [
    "Remember this: selfkey starts locked after every restart and only a human can unlock it.",
    "Save the fact that selfkey comes up locked after a restart.",
    "Keep a note for later \u2014 selfkey is always locked when it restarts.",
    "Store this permanently: selfkey boots locked, a person has to unlock it."
   ],
   "rationale": "A write. Free text is checked for substring only \u2014 grading a model on phrasing a saved fact one exact way would measure wording, not tool use. remember_fact is accepted too, and that is a finding rather than a concession: the belt carries two tools that both save a durable fact, to different stores, and neither description gives a user's phrasing any way to choose. The first run scored memory_save alone and every model came out between 0% and 28% \u2014 not because they failed, but because 52 of 72 calls picked the other reasonable tool. capture_note stays wrong: it appends to today's daily note, which is a log entry, not a durable fact."
  },
  "memory_search": {
   "kind": "tool",
   "expect": "memory_search",
   "destructive": false,
   "prompts": [
    "What have I saved about the Trading 212 key?",
    "Search my memory for anything about Trading 212.",
    "Do I have anything stored about the T212 API key?",
    "Look up what I've noted about Trading 212."
   ],
   "rationale": "Read-side counterpart to memory_save, and a near neighbour of chat_search."
  },
  "home_control": {
   "kind": "tool",
   "expect": "home_control",
   "destructive": false,
   "prompts": [
    "Turn off the living room lights.",
    "Kill the lights in the living room.",
    "Lights off in the living room please.",
    "Switch the living room light off."
   ],
   "rationale": "Three required arguments that have to agree with each other. The common failure is a valid-looking call whose domain and service disagree."
  },
  "network_status": {
   "kind": "tool",
   "expect": "network_status",
   "destructive": false,
   "prompts": [
    "How much traffic is going over the tailnet right now?",
    "What's the Tailscale throughput?",
    "Show me tailnet network usage.",
    "Is anything hammering the tailnet?"
   ],
   "rationale": "Checks a tool outside the app-management cluster is reachable at all."
  },
  "brain_today": {
   "kind": "tool",
   "expect": "brain_today",
   "destructive": false,
   "prompts": [
    "What's on today?",
    "Anything happening today I should know about?",
    "Give me today's rundown.",
    "What does today look like?"
   ],
   "rationale": "Deliberately vague. A model that pattern-matches on keywords has nothing to match; it has to read the tool descriptions."
  },
  "capture_note": {
   "kind": "tool",
   "expect": "capture_note",
   "destructive": false,
   "prompts": [
    "Put in today's daily note that the media drive was unmounted again.",
    "Add a line to today's note: media drive came up unmounted.",
    "Jot down in the daily note that the media drive wasn't mounted.",
    "Note in today's daily note that the media drive dropped again."
   ],
   "rationale": "Sits next to memory_save and remember_fact in the belt. Distinguishes \"writes something down\" from \"writes it in the right place\"."
  }
 },
